# Explicit local development fixture only. Release builds are prepared from a
# merchant identity JSON file and reject APP_VARIANT=local.
APP_VARIANT=local
EXPO_PUBLIC_APP_VARIANT=local
APP_DISPLAY_NAME_BASE=Rawaq
APP_DISPLAY_NAME=Rawaq Local
EXPO_PUBLIC_APP_DISPLAY_NAME=Rawaq Local
APP_VERSION=1.0.1

EXPO_SLUG=rawaqcoffee-local
EXPO_SCHEME=rawaq-local
EXPO_PUBLIC_APP_ICON_PATH=./assets/icon.png
EXPO_PUBLIC_APP_SPLASH_PATH=./assets/splash.png
IOS_BUNDLE_IDENTIFIER=com.lattelink.rawaq.beta
EXPO_PUBLIC_IOS_BUNDLE_IDENTIFIER=com.lattelink.rawaq.beta
IOS_ASSOCIATED_DOMAINS=webcredentials:api-dev.nomly.us

EXPO_PUBLIC_API_BASE_URL=https://api-dev.nomly.us/v1
EXPO_PUBLIC_CATALOG_SERVICE_BASE_URL=https://api-dev.nomly.us/v1
EXPO_PUBLIC_CATALOG_API_BASE_URL=https://api-dev.nomly.us/v1
# Explicit local/dev brand selector; no runtime fallback is applied if this is absent.
EXPO_PUBLIC_BRAND_ID=rawaqcoffee
EXPO_PUBLIC_APPLE_PAY_MERCHANT_ID=merchant.com.lattelink.rawaq.beta
EXPO_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
EXPO_PUBLIC_PRIVACY_POLICY_URL=https://nomly.us/privacy-policy
EXPO_PUBLIC_BRAND_NAME=Rawaq
