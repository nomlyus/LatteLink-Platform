{
  "name": "@lattelink/mobile",
  "version": "1.0.10",
  "private": true,
  "main": "./index.js",
  "scripts": {
    "build:workspace-deps": "cd ../.. && corepack pnpm --filter @lattelink/contracts-core build && corepack pnpm --filter @lattelink/contracts-auth build && corepack pnpm --filter @lattelink/contracts-catalog build && corepack pnpm --filter @lattelink/contracts-orders build && corepack pnpm --filter @lattelink/contracts-loyalty build && corepack pnpm --filter @lattelink/contracts-notifications build && corepack pnpm --filter @lattelink/design-tokens build && corepack pnpm --filter @lattelink/sdk-mobile build",
    "dev": "expo start --clear",
    "dev:client": "expo start --dev-client",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "build": "echo 'Use EAS build for mobile artifacts'",
    "postinstall": "corepack pnpm run build:workspace-deps",
    "release:classify": "node scripts/classify-mobile-release.mjs",
    "release:check": "node scripts/validate-release-env.mjs",
    "merchant-build:prepare": "node scripts/prepare-merchant-build.mjs",
    "update:beta": "eas update --channel beta --environment preview",
    "update:production": "eas update --channel production --environment production",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint app src scripts test --max-warnings=0",
    "test": "vitest run"
  },
  "dependencies": {
    "@expo/dom-webview": "~58.0.2",
    "@expo/metro-runtime": "~58.0.14",
    "@expo/ui": "~58.0.21",
    "@expo/vector-icons": "^15.1.1",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@lattelink/contracts-catalog": "workspace:*",
    "@lattelink/contracts-loyalty": "workspace:*",
    "@lattelink/contracts-orders": "workspace:*",
    "@lattelink/design-tokens": "workspace:*",
    "@lattelink/sdk-mobile": "workspace:*",
    "@react-native-community/datetimepicker": "9.2.1",
    "@react-native-picker/picker": "2.11.4",
    "@sentry/react-native": "^8.31.0",
    "@stripe/stripe-react-native": "0.82.0",
    "@tanstack/react-query": "^5.104.4",
    "expo": "~58.0.16",
    "expo-apple-authentication": "~58.0.2",
    "expo-blur": "~58.0.5",
    "expo-build-properties": "~58.0.11",
    "expo-constants": "~58.0.12",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.14",
    "expo-font": "~58.0.9",
    "expo-glass-effect": "~58.0.4",
    "expo-haptics": "~58.0.7",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.13",
    "expo-notifications": "~58.1.5",
    "expo-router": "~58.0.24",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.10",
    "expo-symbols": "~58.0.4",
    "expo-updates": "~58.0.17",
    "nativewind": "^4.2.7",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-native": "0.88.0",
    "react-native-css-interop": "0.2.7",
    "react-native-gesture-handler": "~3.4.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-worklets": "0.13.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/plugin-transform-react-jsx": "^7.29.7",
    "@expo/ngrok": "^4.1.3",
    "@lattelink/config-eslint": "workspace:*",
    "@react-native/metro-config": "0.88.0",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "babel-preset-expo": "~58.0.18",
    "eslint": "^10.13.0",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.3",
    "vitest": "^5.0.4"
  }
}
