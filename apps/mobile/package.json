{
  "name": "@lattelink/mobile",
  "version": "1.0.10",
  "private": true,
  "main": "./index.js",
  "scripts": {
    "build:workspace-deps": "cd ../.. && corepack pnpm --filter @lattelink/contracts-core build && corepack pnpm --filter @lattelink/contracts-auth build && corepack pnpm --filter @lattelink/contracts-catalog build && corepack pnpm --filter @lattelink/contracts-orders build && corepack pnpm --filter @lattelink/contracts-loyalty build && corepack pnpm --filter @lattelink/contracts-notifications build && corepack pnpm --filter @lattelink/design-tokens build && corepack pnpm --filter @lattelink/sdk-mobile build",
    "dev": "expo start --clear",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "build": "echo 'Use EAS build for mobile artifacts'",
    "postinstall": "corepack pnpm run build:workspace-deps",
    "release:classify": "node scripts/classify-mobile-release.mjs",
    "release:check": "node scripts/validate-release-env.mjs",
    "merchant-build:prepare": "node scripts/prepare-merchant-build.mjs",
    "update:beta": "eas update --channel beta --environment preview",
    "update:production": "eas update --channel production --environment production",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint app src scripts test --max-warnings=0",
    "test": "vitest run"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.17",
    "@expo/vector-icons": "^15.1.1",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@lattelink/contracts-catalog": "workspace:*",
    "@lattelink/contracts-loyalty": "workspace:*",
    "@lattelink/contracts-orders": "workspace:*",
    "@lattelink/design-tokens": "workspace:*",
    "@lattelink/sdk-mobile": "workspace:*",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-picker/picker": "2.11.4",
    "@sentry/react-native": "^8.31.0",
    "@stripe/stripe-react-native": "0.82.0",
    "@tanstack/react-query": "^5.104.3",
    "expo": "~57.0.29",
    "expo-apple-authentication": "~57.0.2",
    "expo-blur": "~57.0.3",
    "expo-build-properties": "~57.0.22",
    "expo-constants": "~57.0.22",
    "expo-crypto": "~57.0.4",
    "expo-font": "~57.0.4",
    "expo-glass-effect": "~57.0.4",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.13",
    "expo-notifications": "~57.0.23",
    "expo-router": "~57.0.27",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.10",
    "expo-updates": "~57.0.26",
    "nativewind": "^4.2.7",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-css-interop": "0.2.7",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-worklets": "0.10.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/plugin-transform-react-jsx": "^7.29.7",
    "@expo/ngrok": "^4.1.3",
    "@lattelink/config-eslint": "workspace:*",
    "@types/react": "~19.2.18",
    "@types/react-dom": "~19.2.3",
    "babel-preset-expo": "~57.0.15",
    "eslint": "^10.12.0",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.3",
    "vitest": "^5.0.4"
  }
}
