{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "ios": {
        "resourceClass": "m-medium"
      }
    },
    "beta": {
      "extends": "base",
      "autoIncrement": true,
      "distribution": "store",
      "environment": "preview",
      "channel": "beta",
      "env": {
        "APP_VARIANT": "beta",
        "EXPO_PUBLIC_APP_VARIANT": "beta"
      }
    },
    "production": {
      "extends": "base",
      "autoIncrement": true,
      "distribution": "store",
      "environment": "production",
      "channel": "production",
      "ios": {
        "resourceClass": "m-medium",
        "buildConfiguration": "ReleaseProduction"
      },
      "env": {
        "APP_VARIANT": "production",
        "EXPO_PUBLIC_APP_VARIANT": "production"
      }
    }
  },
  "submit": {
    "beta": {
      "ios": {}
    },
    "production": {
      "ios": {}
    }
  }
}
