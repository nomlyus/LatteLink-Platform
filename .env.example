EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:8080/v1
LOG_LEVEL=info
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
# Deployed Heroku apps use Supabase Shared Pooler session mode for IPv4 access.
DATABASE_URL='postgresql://postgres.[project-ref]:[password]@aws-1-[region].pooler.supabase.com:5432/postgres?sslmode=require'
POSTGRES_POOL_MAX=2
POSTGRES_CONNECTION_TIMEOUT_MS=5000
POSTGRES_IDLE_TIMEOUT_MS=10000
# Compose deployments set per-service pools explicitly. Keep local defaults small.
POSTGRES_POOL_BUDGET_LIMIT=30
POSTGRES_POOL_HEADROOM_MIN=10
IDENTITY_POSTGRES_POOL_MAX=2
ORDERS_POSTGRES_POOL_MAX=2
CATALOG_POSTGRES_POOL_MAX=2
PAYMENTS_POSTGRES_POOL_MAX=2
LOYALTY_POSTGRES_POOL_MAX=2
NOTIFICATIONS_POSTGRES_POOL_MAX=2
PAYMENT_RECONCILER_POSTGRES_POOL_MAX=1
# Heroku's public gateway binds PORT. These loopback ports are only for the
# single-dyno backend runtime and must remain unique.
BACKEND_RUNTIME_INTERNAL_HOST=127.0.0.1
BACKEND_RUNTIME_IDENTITY_PORT=3100
BACKEND_RUNTIME_ORDERS_PORT=3101
BACKEND_RUNTIME_CATALOG_PORT=3102
BACKEND_RUNTIME_PAYMENTS_PORT=3103
BACKEND_RUNTIME_LOYALTY_PORT=3104
BACKEND_RUNTIME_NOTIFICATIONS_PORT=3105
ALLOW_IN_MEMORY_PERSISTENCE=
# Run migrations manually: pnpm --filter @lattelink/persistence migrate
CATALOG_SERVICE_BASE_URL=http://127.0.0.1:3002
# Required for deployed service-to-service auth. Local tests may use explicit test bypass flags.
GATEWAY_INTERNAL_API_TOKEN=
LOYALTY_INTERNAL_API_TOKEN=
NOTIFICATIONS_INTERNAL_API_TOKEN=
GATEWAY_UPSTREAM_TIMEOUT_MS=5000
GATEWAY_RATE_LIMIT_WINDOW_MS=60000
GATEWAY_RATE_LIMIT_AUTH_WRITE_MAX=24
GATEWAY_RATE_LIMIT_AUTH_READ_MAX=120
GATEWAY_RATE_LIMIT_CATALOG_READ_MAX=180
GATEWAY_RATE_LIMIT_ORDERS_READ_MAX=120
GATEWAY_RATE_LIMIT_ORDERS_WRITE_MAX=60
GATEWAY_RATE_LIMIT_CHECKOUT_MAX=20
GATEWAY_RATE_LIMIT_LOYALTY_READ_MAX=120
GATEWAY_RATE_LIMIT_PUSH_TOKEN_MAX=30
GATEWAY_ORDER_STREAM_MAX_PER_LOCATION=100
# Optional per-process cap across all open order SSE streams.
GATEWAY_ORDER_STREAM_MAX_GLOBAL=
PASSKEY_RP_ID=localhost
PASSKEY_RP_NAME=Gazelle
PASSKEY_EXPECTED_ORIGINS=https://localhost
PASSKEY_TIMEOUT_MS=60000
# Set the same JWT_SECRET on identity and gateway to enable locally verified JWT access tokens.
# Use at least 32 characters. Example: openssl rand -base64 48
# When unset, access tokens fall back to the legacy opaque-token path.
JWT_SECRET=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_CLIENT_ID=
APPLE_ALLOWED_CLIENT_IDS=
IDENTITY_RATE_LIMIT_WINDOW_MS=60000
IDENTITY_RATE_LIMIT_AUTH_WRITE_MAX=24
IDENTITY_RATE_LIMIT_AUTH_READ_MAX=120
IDENTITY_RATE_LIMIT_PASSKEY_CHALLENGE_MAX=24
IDENTITY_RATE_LIMIT_PASSKEY_VERIFY_MAX=12
CLIENT_DASHBOARD_BASE_URL=http://127.0.0.1:4173
EMAIL_PROVIDER=console
OWNER_INVITE_EMAIL_FROM=
RESEND_API_KEY=
# Google OAuth for client dashboard operator sign-in.
# Keep the redirect URI list exact and comma-separated.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_STATE_SECRET=
GOOGLE_OAUTH_ALLOWED_REDIRECT_URIS=http://127.0.0.1:4173/?google_auth_callback=1
# Clover live/sandbox mode:
# - leave PAYMENTS_PROVIDER_MODE=simulated for normal local development
# - switch to live only when Clover OAuth is configured and merchants connect through the OAuth flow
PAYMENTS_PROVIDER_MODE=simulated
CLOVER_OAUTH_ENVIRONMENT=sandbox
CLOVER_APP_ID=
CLOVER_APP_SECRET=
CLOVER_OAUTH_REDIRECT_URI=
CLOVER_OAUTH_STATE_SECRET=
CLOVER_WEBHOOK_SHARED_SECRET=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_CONNECT_WEBHOOK_SECRET=
ORDERS_SERVICE_BASE_URL=http://127.0.0.1:3001
ORDERS_INTERNAL_API_TOKEN=
# Optional one-time internal admin bootstrap. Leave blank unless creating the first admin user.
DEFAULT_INTERNAL_ADMIN_OWNER_EMAIL=
DEFAULT_INTERNAL_ADMIN_OWNER_PASSWORD=
DEFAULT_INTERNAL_ADMIN_OWNER_NAME=
DEFAULT_INTERNAL_ADMIN_OPERATOR_EMAIL=
DEFAULT_INTERNAL_ADMIN_OPERATOR_PASSWORD=
DEFAULT_INTERNAL_ADMIN_OPERATOR_NAME=
DEFAULT_INTERNAL_ADMIN_SUPPORT_EMAIL=
DEFAULT_INTERNAL_ADMIN_SUPPORT_PASSWORD=
DEFAULT_INTERNAL_ADMIN_SUPPORT_NAME=
