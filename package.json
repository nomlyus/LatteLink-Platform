{
  "name": "lattelink-platform",
  "private": true,
  "version": "1.0.4",
  "description": "LatteLink platform monorepo",
  "license": "MIT",
  "packageManager": "pnpm@10.5.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "build": "turbo run build",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "dev": "turbo run dev --parallel",
    "dev:services": "./scripts/dev-local-services.sh",
    "dev:services:lan": "./scripts/dev-local-services-lan.sh",
    "dev:mobile:local": "EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:8080/v1 pnpm --filter @lattelink/mobile dev",
    "dev:mobile:lan": "./scripts/dev-mobile-lan.sh",
    "dev:worker:menu-sync": "pnpm --filter @lattelink/menu-sync-worker dev",
    "dev:worker:notifications-dispatch": "pnpm --filter @lattelink/notifications-dispatch-worker dev",
    "dev:worker:payment-reconciler": "pnpm --filter @lattelink/payment-reconciler-worker dev",
    "provision:client-owner": "pnpm --filter @lattelink/identity provision:owner",
    "contracts:openapi": "turbo run openapi --filter=@lattelink/gateway --filter=@lattelink/contracts-*",
    "contracts:drift": "./scripts/verify-contract-drift.sh",
    "release:validate-tag": "node scripts/validate-release-tag.mjs",
    "test:release-policy": "node --test scripts/validate-release-tag.test.mjs scripts/validate-production-release.test.mjs",
    "sdk:generate": "pnpm --filter @lattelink/sdk-mobile generate",
    "terraform:fmt": "terraform -chdir=infra/terraform/envs/dev fmt -recursive -check",
    "terraform:validate": "pnpm -r --filter ./infra/terraform/envs/* run validate"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@types/node": "^22.13.8",
    "eslint": "^9.21.0",
    "eslint-config-prettier": "^10.1.1",
    "prettier": "^3.5.3",
    "turbo": "^2.9.14",
    "typescript": "^5.8.2",
    "vitest": "^4.1.8"
  },
  "pnpm": {
    "overrides": {
      "@fastify/static": "9.1.1",
      "@xmldom/xmldom": "0.8.13",
      "brace-expansion@<1.1.13": "1.1.13",
      "brace-expansion@>=2.0.0 <2.0.3": "2.0.3",
      "brace-expansion@>=4.0.0 <5.0.6": "5.0.6",
      "fast-uri": "3.1.2",
      "fastify": "5.8.5",
      "flatted": "3.4.2",
      "node-forge": "1.4.0",
      "picomatch": "4.0.4",
      "postcss": "8.5.10",
      "tar": "7.5.11",
      "undici": "6.24.0",
      "uuid": "11.1.1",
      "ws": "8.20.1",
      "yaml": "2.8.3"
    }
  }
}
