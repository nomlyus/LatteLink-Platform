# Per-environment compose project name. Set a distinct value for dev vs prod.
COMPOSE_PROJECT_NAME=lattelink-dev

# Public API and dashboard domains served by Caddy
API_DOMAIN=api-dev.example.com
CLIENT_DASHBOARD_DOMAIN=app-dev.example.com
LETSENCRYPT_EMAIL=ops@example.com

# GHCR image prefix and tag to deploy
IMAGE_REGISTRY_PREFIX=ghcr.io/anxiousdaoud/lattelink-platform
IMAGE_TAG=latest
APP_VERSION=unknown

# Runtime observability
LOG_LEVEL=info
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Runtime secrets and service auth
DATABASE_URL=postgresql://postgres.<project-ref>:replace-me@aws-0-us-east-1.pooler.supabase.com:5432/postgres
POSTGRES_CONNECTION_TIMEOUT_MS=5000
POSTGRES_IDLE_TIMEOUT_MS=10000
# Dev defaults are intentionally conservative. Production deploy writes explicit higher values.
POSTGRES_POOL_BUDGET_LIMIT=30
POSTGRES_POOL_HEADROOM_MIN=10
IDENTITY_POSTGRES_POOL_MAX=2
ORDERS_POSTGRES_POOL_MAX=2
CATALOG_POSTGRES_POOL_MAX=2
PAYMENTS_POSTGRES_POOL_MAX=2
LOYALTY_POSTGRES_POOL_MAX=2
NOTIFICATIONS_POSTGRES_POOL_MAX=2
PAYMENT_RECONCILER_POSTGRES_POOL_MAX=1
# Deployed environments should always point DATABASE_URL at Supabase.
# POSTGRES_PASSWORD is only used when you explicitly start the optional local Postgres profile:
#   docker compose --profile local-db up -d
POSTGRES_PASSWORD=
# Required service-to-service tokens. Generate unique values per environment.
GATEWAY_INTERNAL_API_TOKEN=replace-me
ORDERS_INTERNAL_API_TOKEN=replace-me
LOYALTY_INTERNAL_API_TOKEN=replace-me
NOTIFICATIONS_INTERNAL_API_TOKEN=replace-me
JWT_SECRET=replace-me-with-a-32-char-secret
# Optional one-time internal admin bootstrap. Leave blank unless creating the first admin user.
# Reusing these values will not overwrite an existing internal admin with the same email.
DEFAULT_INTERNAL_ADMIN_OWNER_EMAIL=
DEFAULT_INTERNAL_ADMIN_OWNER_PASSWORD=
DEFAULT_INTERNAL_ADMIN_OWNER_NAME=
DEFAULT_INTERNAL_ADMIN_OPERATOR_EMAIL=
DEFAULT_INTERNAL_ADMIN_OPERATOR_PASSWORD=
DEFAULT_INTERNAL_ADMIN_OPERATOR_NAME=
DEFAULT_INTERNAL_ADMIN_SUPPORT_EMAIL=
DEFAULT_INTERNAL_ADMIN_SUPPORT_PASSWORD=
DEFAULT_INTERNAL_ADMIN_SUPPORT_NAME=
NOTIFICATIONS_PROVIDER_MODE=expo
EXPO_PUSH_API_URL=
EXPO_ACCESS_TOKEN=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_ALLOWED_CLIENT_IDS=com.lattelink.rawaq.beta,com.lattelink.rawaq
PAYMENTS_PROVIDER_MODE=simulated
# ORDER_FULFILLMENT_MODE: "staff" for real merchants, "time_based" for demos only.
# Default is staff. Do not use time_based for live pilot merchants.
ORDER_FULFILLMENT_MODE=staff
CLOVER_OAUTH_ENVIRONMENT=sandbox
CLOVER_APP_ID=
CLOVER_APP_SECRET=
CLOVER_OAUTH_REDIRECT_URI=
CLOVER_OAUTH_STATE_SECRET=
CLOVER_WEBHOOK_SHARED_SECRET=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_CONNECT_WEBHOOK_SECRET=
CATALOG_MEDIA_R2_ACCOUNT_ID=
CATALOG_MEDIA_R2_ACCESS_KEY_ID=
CATALOG_MEDIA_R2_SECRET_ACCESS_KEY=
CATALOG_MEDIA_R2_BUCKET=
CATALOG_MEDIA_PUBLIC_BASE_URL=
CATALOG_MEDIA_UPLOAD_MAX_BYTES=10485760
CATALOG_MEDIA_UPLOAD_EXPIRY_SECONDS=300

# Gateway runtime
CORS_ALLOWED_ORIGINS=https://app-dev.example.com,https://admin-dev.example.com
# Optional host suffix allowlist for ephemeral preview origins (for example Vercel preview deployments).
# Use only in non-production environments.
CORS_ALLOWED_ORIGIN_HOST_SUFFIXES=
PUBLIC_API_BASE_URL=https://api-dev.example.com/v1
GATEWAY_UPSTREAM_TIMEOUT_MS=5000
GATEWAY_RATE_LIMIT_WINDOW_MS=60000

# Passkey RP ID for identity service
PASSKEY_RP_ID=api-dev.example.com
ALLOW_DEV_CUSTOMER_LOGIN=false
CUSTOMER_SESSION_ABSOLUTE_TTL_DAYS=90
OPERATOR_SESSION_ABSOLUTE_TTL_DAYS=30
INTERNAL_ADMIN_SESSION_ABSOLUTE_TTL_DAYS=14

# Google SSO for the client dashboard
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_STATE_SECRET=
GOOGLE_OAUTH_ALLOWED_REDIRECT_URIS=

# Optional external menu-sync worker configuration.
# Leave WEBAPP_MENU_SOURCE_URL blank to keep the worker deployed but disabled.
WEBAPP_MENU_SOURCE_URL=
MENU_SYNC_LOCATION_ID=rawaqcoffee01
MENU_SYNC_INTERVAL_MS=300000
MENU_SYNC_MAX_RETRIES=3
MENU_SYNC_RETRY_DELAY_MS=2000

# Optional single-tenant public catalog fallback.
# Leave CATALOG_DEFAULT_LOCATION_ID empty for multi-tenant/pilot safety so missing locationId fails clearly.
CATALOG_DEFAULT_LOCATION_ID=
CATALOG_DEFAULT_BRAND_ID=
CATALOG_DEFAULT_BRAND_NAME=
CATALOG_DEFAULT_LOCATION_NAME=
CATALOG_DEFAULT_MARKET_LABEL=
